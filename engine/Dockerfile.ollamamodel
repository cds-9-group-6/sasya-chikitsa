# Cross-platform Ollama Multi-Model container for OpenShift deployment
# Uses pre-downloaded model files to avoid emulation issues
# Contains: llama3.1:8b (text) + llava-llama3:8b (vision)

FROM ollama/ollama:latest

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy pre-downloaded model files from build context
# These should be downloaded locally using: ./engine/download-models.sh
COPY engine/model_files /root/.ollama/models

# Create production-ready startup script
RUN echo '#!/bin/sh' > /entrypoint.sh && \
    echo 'echo "🚀 Starting Ollama with pre-loaded models..."' >> /entrypoint.sh && \
    echo 'echo "📝 Text AI: llama3.1:8b"' >> /entrypoint.sh && \
    echo 'echo "👁️  Vision AI: llava-llama3:8b"' >> /entrypoint.sh && \
    echo 'echo "🏢 Ready for OpenShift deployment"' >> /entrypoint.sh && \
    echo 'echo "📁 Model files:"' >> /entrypoint.sh && \
    echo 'ls -la /root/.ollama/models/' >> /entrypoint.sh && \
    echo 'echo "🎯 Available models:"' >> /entrypoint.sh && \
    echo 'ollama list || echo "Models will be available after server starts"' >> /entrypoint.sh && \
    echo 'exec ollama serve' >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

# Add health check for OpenShift
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:11434/api/version || exit 1

# Expose Ollama API port
EXPOSE 11434

# Use exec form for better signal handling in OpenShift
ENTRYPOINT ["/entrypoint.sh"]
